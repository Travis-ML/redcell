# Model (LiteLLM format). Local-first examples first, cloud below.
#   hosted_vllm/<model>         (self-hosted vLLM)  + AGENT_API_BASE
#   ollama/llama3.1             (local Ollama)
#   anthropic/claude-opus-4-8   (cloud)             + ANTHROPIC_API_KEY
#   openai/gpt-4o               (cloud)             + OPENAI_API_KEY
AGENT_MODEL=anthropic/claude-opus-4-8

# OpenAI-compatible endpoint override (self-hosted vLLM / LM Studio).
#   AGENT_API_BASE=http://YOUR_HOST:8000/v1
AGENT_API_BASE=
AGENT_API_KEY=

# Provider keys (set whichever you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generation
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=1024
AGENT_MAX_ITERATIONS=25
# Context window (tokens). 0 disables auto-compaction; set to your model's window
# (e.g. 8192 for a small local model) so long runs summarize old turns instead of
# overflowing. Keeps a recent tail verbatim; recovers from a real overflow.
AGENT_CONTEXT_WINDOW=0
AGENT_COMPACT_RATIO=0.8
# Transient-error retry for LLM calls (429/5xx/connection). 0 disables. Honors
# Retry-After; never retries 4xx/auth/validation. Backoff = base*2^(n-1)+jitter.
AGENT_LLM_MAX_RETRIES=5
AGENT_LLM_RETRY_BASE_DELAY=0.5
AGENT_LLM_RETRY_MAX_DELAY=30.0
AGENT_LOG_LEVEL=INFO
# Structured-event output. Set JSON + a file to get a JSONL event sink per scan
# (every event carries a run_id; tool_end includes duration_ms and the result).
AGENT_LOG_JSON=false
# AGENT_LOG_FILE=runs/events.jsonl
# Silence the MCP transport's benign teardown-race logs (SSE ClosedResourceError +
# "Session termination failed: 202"). Set false to keep them when debugging it.
AGENT_LOG_QUIET_MCP_TRANSPORT=true
# Per-run cost/token/activity scorecard event at each request's end (pricing in
# redcell/pricing.py; local models count tokens at $0). Set false to disable.
AGENT_SCORECARD=true

# OpenAI-compatible server (point Open WebUI / Garak / Promptfoo here)
AGENT_SERVER_HOST=0.0.0.0
AGENT_SERVER_PORT=8800
AGENT_MODEL_ID=redcell
AGENT_SERVER_API_KEY=

# Stateful sessions: send this header (or a body `session_id`) and redcell
# remembers that conversation server-side, so the client sends only the new turn
# (promptfoo "client-generated session id" mode). Omit the header for the default
# stateless behavior (client resends full history).
AGENT_SESSION_HEADER=x-redcell-session
AGENT_SESSION_TTL_SECONDS=3600.0
AGENT_SESSION_MAX=1000

# Security controls (secure-by-default). Flip any of these to recreate the
# deliberately vulnerable target for red-team baselining.
#   AGENT_SAFETY_PROMPT=false       drop the safety policy from the system prompt
#   AGENT_GUARDRAILS=false          disable the input/output guardrail
#   AGENT_MCP_TOOL_DENYLIST=shell,filesystem   drop dangerous gateway tools
AGENT_SAFETY_PROMPT=true
AGENT_GUARDRAILS=true
AGENT_MCP_TOOL_DENYLIST=
# Subset of safety rules to include (empty = all). Lets you measure each rule's
# individual contribution. Names: harm,copyright,truthfulness,commitments,disclosure,fairness
AGENT_SAFETY_RULES=
# Permission policy engine (allow/deny/ask over tool calls). false = allow all
# (baseline). Rules: "Tool" or "Tool(content)"; deny > ask > allow. Content can't
# contain a comma via env. ASK_RESOLUTION decides headless "ask" (deny|allow).
AGENT_PERMISSIONS=true
AGENT_PERMISSION_ALLOW=
AGENT_PERMISSION_DENY=
AGENT_PERMISSION_ASK=
AGENT_PERMISSION_DEFAULT=allow
AGENT_PERMISSION_ASK_RESOLUTION=deny
# MCP tools (name substring, case-insensitive) to run in parallel as read-only.
# Empty = default: fetch, qdrant-find, filesystem reads, grep. Setting this
# REPLACES the default. Mutating tools (shell, writes, qdrant-store) stay serial.
AGENT_MCP_READONLY_TOOLS=

# SearXNG instance backing the web_search tool
AGENT_SEARXNG_URL=http://127.0.0.1:8989

# AgentGateway — serve launches it and proxies MCP traffic through it
AGENT_GATEWAY_BIN=agentgateway
AGENT_GATEWAY_CONFIG=agentgateway/config.yaml
AGENT_GATEWAY_HOST=127.0.0.1
AGENT_GATEWAY_PORT=3030
AGENT_GATEWAY_URL=http://127.0.0.1:3030/mcp
AGENT_GATEWAY_AUTOSTART=true
AGENT_GATEWAY_READY_TIMEOUT=30.0

# Execution sandbox: shell/filesystem run inside an OpenShell sandbox, never on
# this host. `serve` creates the sandbox and writes the SSH config the gateway
# launches those servers through. See sandbox/README.md.
AGENT_OPENSHELL_AUTOSTART=true
AGENT_OPENSHELL_BIN=openshell
# Must be published on port 8080 specifically: the docker driver tells sandboxes
# to call back on the gateway's own port, so remapping it hangs them in
# Provisioning. Health is on its own port, not the control-plane one.
AGENT_OPENSHELL_GATEWAY_URL=http://127.0.0.1:8080
AGENT_OPENSHELL_HEALTH_URL=http://127.0.0.1:8081/healthz
AGENT_OPENSHELL_GATEWAY_NAME=redcell
AGENT_OPENSHELL_SANDBOX=redcell-sbx
AGENT_OPENSHELL_WORKSPACE=default
# Built locally: docker build -t redcell-sandbox:local sandbox/
AGENT_OPENSHELL_IMAGE=redcell-sandbox:local
AGENT_OPENSHELL_POLICY_PATH=sandbox/policy.yaml
AGENT_OPENSHELL_SSH_CONFIG_PATH=.redcell/openshell_ssh_config
AGENT_OPENSHELL_READY_TIMEOUT=60.0
# Generous: a cold first run pulls the supervisor and sandbox images.
AGENT_OPENSHELL_CREATE_TIMEOUT=600.0
# Reusing the sandbox across restarts skips image pulls; true for a clean one.
AGENT_OPENSHELL_DELETE_ON_EXIT=false

# Qdrant (RAG store) — serve brings it up via `docker compose up -d`, the same
# way it launches the gateway. Needs Docker; degrades gracefully if absent.
# Set AUTOSTART=false to manage Qdrant yourself; STOP_ON_EXIT=true to also stop
# the container when serve exits (it's left running by default).
AGENT_QDRANT_AUTOSTART=true
AGENT_QDRANT_COMPOSE_FILE=docker-compose.yml
AGENT_QDRANT_SERVICE=qdrant
AGENT_QDRANT_HOST=127.0.0.1
AGENT_QDRANT_PORT=6333
AGENT_QDRANT_READY_TIMEOUT=30.0
AGENT_QDRANT_STOP_ON_EXIT=false

# Document ingestion — at startup, chunk PDFs in DOCS_DIR and store them in
# Qdrant so the agent can retrieve them (qdrant-find). A hash manifest skips
# files already ingested unchanged. Drop your PDFs in ./documents (flat folder).
AGENT_DOCS_AUTOLOAD=true
AGENT_DOCS_DIR=documents
AGENT_DOCS_MANIFEST_PATH=.redcell/ingested.json
AGENT_DOCS_CHUNK_SIZE=1000
AGENT_DOCS_CHUNK_OVERLAP=150

# --- OpenTelemetry tracing (opt-in) ---
# One trace per request: the HTTP span at the root, agent.run beneath it, a child
# span per LLM call and tool call, guardrail/permission/compaction as span events.
# Needs the optional dependency group: `uv sync --extra tracing`. The Docker image
# already has it, so in the compose stack this is just a flag.
#
# Spans carry full prompt, completion and tool-argument content. That is the point
# for red-team forensics, but it means a trace backend holds a LESS filtered record
# than the API response: the output guardrail redacts what reaches the client, not
# what reached the span. See docs/observability.md.
AGENT_TRACING=false
# http://otel-collector:4317 inside the compose stack.
AGENT_TRACING_ENDPOINT=http://127.0.0.1:4317
AGENT_TRACING_PROTOCOL=grpc
AGENT_TRACING_SERVICE_NAME=redcell
AGENT_TRACING_SAMPLE_RATIO=1.0
AGENT_TRACING_INSTRUMENT_HTTP=true

# Ship logs to the collector too, so a log line can be joined to its trace by
# trace_id. The compose stack mounts this path as a shared volume.
# AGENT_LOG_JSON=true
# AGENT_LOG_FILE=/var/log/redcell/events.jsonl

# --- docker compose stack -----------------------------------------------------
# Read by docker-compose.yml, not by redcell itself.

# Required by the searxng service. Generate once: openssl rand -hex 32
SEARXNG_SECRET=

# Grafana Cloud, for `OTEL_CONFIG=./otel/collector-grafanacloud.yaml`. Auth is the
# base64 of "<instanceID>:<token>": printf '%s' 'id:token' | base64
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# GRAFANA_CLOUD_OTLP_AUTH=
